{
  "name": "@_linked/owl",
  "displayName": "Web Ontology Language",
  "license": "UNLICENSED",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "version": "1.6.2",
  "packageManager": "npm@12.2.0",
  "linkedPackage": true,
  "linkedOntologies": {
    "owl": {
      "namespace": "http://www.w3.org/2002/07/owl#"
    }
  },
  "type": "module",
  "author": {
    "name": "René Verheij",
    "url": "https://github.com/flyon",
    "email": "rpwverheij@gmail.com"
  },
  "main": "lib/esm/index.js",
  "types": "index.d.ts",
  "scripts": {
    "start": "npm exec linked dev",
    "build": "linked build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@_linked/core": "^2.41.0",
    "@_linked/rdfs": "^1.4.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.57.1",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.19.1",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "module": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/owl.git"
  }
}
